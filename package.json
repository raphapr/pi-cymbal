{
  "name": "pi-cymbal",
  "version": "0.1.0",
  "description": "Pi extension exposing Cymbal as an agent-native code navigation layer.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "cymbal", "code-navigation"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "files": ["src/", "README.md", "AGENTS.md", "tsconfig.json"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.mjs\"",
    "validate": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@mariozechner/pi-tui": "^0.73.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  }
}
